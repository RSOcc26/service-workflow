# Configuration for service-workflow.
# Copy to .env for local development. Never commit .env.
# Every value below is a placeholder; real credentials come from Kubernetes
# Secrets or your local .env only.

# HTTP
PORT=3003
LOG_LEVEL=info

# PostgreSQL: this service's own database (ADR-0001).
# Runtime role: DML only, not the table owner, no BYPASSRLS.
DATABASE_URL=postgres://workflow_app:change-me@localhost:5432/workflow
# Migration role: owns the schema; used only when applying migrations.
DATABASE_MIGRATION_URL=postgres://workflow_migrator:change-me@localhost:5432/workflow

# Apache Kafka. The local broker has no authentication; in Kubernetes each
# service has its own SCRAM user restricted by ACLs.
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=service-workflow
KAFKA_TOPIC=workflow.events
KAFKA_GROUP_ID=workflow
KAFKA_CONSUME_TOPICS=production.events
KAFKA_DLT_TOPIC=workflow.dlt
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Tenant context signed by the gateway (ADR-0001)
TENANT_CONTEXT_JWKS_URL=http://localhost:8080/.well-known/jwks.json
TENANT_CONTEXT_ISSUER=companycentral-gateway
TENANT_CONTEXT_AUDIENCE=service-workflow
